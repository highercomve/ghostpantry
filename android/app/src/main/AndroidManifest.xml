<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by `oriel android init` from build.zig (rewritten by `oriel android init` with the force flag). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- oriel:permissions begin -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- oriel:permissions end -->
    <!-- oriel:features begin -->
    <!-- oriel:features end -->
    <!-- oriel:queries begin -->
    <!-- oriel.dictation's system engine: Android 11+ only lets apps see the
         speech recognition services they declare. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- oriel:queries end -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Oriel"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsRtl="true">

        <!-- GPU/NPU drivers ggml may use (src/modules/ggml_gpu.zig): optional,
             Android 12+ only lets apps open vendor libraries they declare. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <activity
            android:name="dev.oriel.OrielMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale">
            <layout
                android:defaultWidth="960dp"
                android:defaultHeight="720dp"
                android:minWidth="360dp"
                android:minHeight="320dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- oriel:main-activity begin -->
            <!-- oriel:main-activity end -->
        </activity>

        <activity
            android:name="dev.oriel.OrielWindowActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale" />

        <receiver
            android:name="dev.oriel.OrielActionReceiver"
            android:exported="false" />

        <provider
            android:name="dev.oriel.OrielFileProvider"
            android:authorities="${applicationId}.oriel.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name="dev.ghostpantry.PantryCameraProvider"
            android:authorities="${applicationId}.pantry.camera"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- oriel:components begin -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <!-- oriel:components end -->
    </application>
